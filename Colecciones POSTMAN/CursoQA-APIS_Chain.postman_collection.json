            {
              "name": "Add New Navegador",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const navegadores = [\"Chrome\", \"Firefox\", \"Edge\", \"Safari\", \"Opera\", \"Brave\", \"Ecosia\"];\r",
                      "\r",
                      "const nombreAleatorio =\r",
                      "  navegadores[Math.floor(Math.random() * navegadores.length)] +\r",
                      "  \" \" +\r",
                      "  Math.floor(Math.random() * 100);\r",
                      "\r",
                      "console.log(\"Nombre Aleatorio:\", nombreAleatorio);\r",
                      "\r",
                      "const porcentajeAleatorio=(Math.random()*30+1).toFixed(1);\r",
                      "console.log(\"Porcentaje Aleatorio:\", porcentajeAleatorio);\r",
                      "\r",
                      "pm.environment.set(\"nuevonombre\", nombreAleatorio);\r",
                      "pm.environment.set(\"nuevoPorcentaje\", porcentajeAleatorio);"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code es 201\", function () {\r",
                      "    pm.response.to.have.status(201);\r",
                      "});\r",
                      "\r",
                      "const response = pm.response.json();\r",
                      "\r",
                      "if (response.id) {\r",
                      "    pm.environment.set(\"navegador_id_actual\", response.id);\r",
                      "    console.log(\"navegador_id_actual actualizado:\", response.id);\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
