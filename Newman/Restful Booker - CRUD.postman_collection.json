    {
      "name": "05 - Actualizar reservación parcial",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const respuesta = pm.response.json();\r",
              "pm.test(\"Código de respuesta 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene los campos actualizados\", function () {\r",
              "    pm.expect(respuesta).to.be.an(\"object\");\r",
              "    pm.expect(respuesta).to.have.property(\"totalprice\");\r",
              "    pm.expect(respuesta).to.have.property(\"additionalneeds\");\r",
              "});\r",
              "\r",
              "pm.test(\"Los campos actualizados coinciden con los enviados\", function () {\r",
              "    const datosEnviados = JSON.parse(\r",
              "        pm.variables.replaceIn(pm.request.body.raw)\r",
              "    );\r",
              "    pm.expect(respuesta.totalprice).to.eql(datosEnviados.totalprice);\r",
              "    pm.expect(respuesta.additionalneeds).to.eql(datosEnviados.additionalneeds);\r",
              "});\r",
              "\r",
              "pm.test(\"Los campos no modificados se conservan\", function () {\r",
              "    const depositoEsperado = JSON.parse(\r",
              "        String(pm.collectionVariables.get(\"depositpaid\"))\r",
              "    );\r",
              "    pm.expect(respuesta.firstname)\r",
              "        .to.eql(pm.iterationData.get(\"firstname\"));\r",
              "    pm.expect(respuesta.lastname)\r",
              "        .to.eql(pm.iterationData.get(\"lastname\") + \" Actualizado\");\r",
              "    pm.expect(respuesta.depositpaid)\r",
              "        .to.eql(depositoEsperado);\r",
              "    pm.expect(respuesta.bookingdates.checkin)\r",
              "        .to.eql(pm.iterationData.get(\"checkin\"));\r",
              "    pm.expect(respuesta.bookingdates.checkout)\r",
              "        .to.eql(pm.iterationData.get(\"checkout\"));\r",
              "});\r",
              "\r",
              "pm.test(\"El tiempo de respuesta es menor a 2000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const precioAnterior = Number(\r",
              "    pm.collectionVariables.get(\"totalprice\")\r",
              ");\r",
              "\r",
              "const precioPatch = precioAnterior + 500;\r",
              "\r",
              "pm.collectionVariables.set(\"totalprice_patch\", precioPatch);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
