    {
      "name": "New Folder",
      "item": [
        {
          "name": "00 - Verificar API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"La API está disponible\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta confirma disponibilidad\", function () {\r",
                  "    pm.expect(pm.response.text()).to.eql(\"Created\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
