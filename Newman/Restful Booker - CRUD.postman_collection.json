        {
          "name": "01 - Crear token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const respuesta = pm.response.json();\r",
                  "pm.environment.set(\"auth_token\", respuesta.token);\r",
                  "\r",
                  "pm.test(\"Código de respuesta 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta contiene un token válido\", function () {\r",
                  "    pm.expect(respuesta).to.have.property(\"token\");\r",
                  "    pm.expect(respuesta.token).to.be.a(\"string\");\r",
                  "    pm.expect(respuesta.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Crear reservación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const respuesta = pm.response.json();\r",
                  "pm.environment.set(\"booking_id\", respuesta.bookingid);\r",
                  "\r",
                  "pm.environment.set(\r",
                  "    \"booking_esperado\",\r",
                  "    JSON.stringify(respuesta.booking)\r",
                  ");\r",
                  "\r",
                  "pm.test(\"Código de respuesta 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta contiene un bookingid\", function () {\r",
                  "    pm.expect(respuesta).to.have.property(\"bookingid\");\r",
                  "    pm.expect(respuesta.bookingid).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta contiene los datos de la reservación\", function () {\r",
                  "    pm.expect(respuesta).to.have.property(\"booking\");\r",
                  "    pm.expect(respuesta.booking).to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Los datos recibidos coinciden con los enviados\", function () {\r",
                  "    const datosEnviados = JSON.parse(\r",
                  "        pm.variables.replaceIn(pm.request.body.raw)\r",
                  "    );\r",
                  "    pm.expect(respuesta.booking).to.eql(datosEnviados);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const precioAleatorio = Math.floor(Math.random() * 901) + 100;\r",
                  "pm.collectionVariables.set(\"totalprice\", precioAleatorio);\r",
                  "\r",
                  "const depositoAleatorio = Math.random() < 0.5;\r",
                  "pm.collectionVariables.set(\"depositpaid\", depositoAleatorio);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstname}}\",\r\n  \"lastname\": \"{{lastname}}\",\r\n  \"totalprice\": {{totalprice}},\r\n  \"depositpaid\": {{depositpaid}},\r\n  \"bookingdates\": {\r\n    \"checkin\": \"{{checkin}}\",\r\n    \"checkout\": \"{{checkout}}\"\r\n},\r\n  \"additionalneeds\": \"{{additionalneeds}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/booking",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 - Consultar reservación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const respuesta = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Código de respuesta 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Los datos consultados coinciden con la reservación creada\", function () {\r",
                  "    const bookingEsperado = JSON.parse(\r",
                  "        pm.environment.get(\"booking_esperado\")\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(respuesta).to.eql(bookingEsperado);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/booking/{{booking_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "booking",
                "{{booking_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Actualizar reservación completa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const respuesta = pm.response.json();\r",
              "pm.test(\"Código de respuesta 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene los datos actualizados\", function () {\r",
              "    pm.expect(respuesta).to.be.an(\"object\");\r",
              "    pm.expect(respuesta).to.have.property(\"firstname\");\r",
              "    pm.expect(respuesta).to.have.property(\"lastname\");\r",
              "    pm.expect(respuesta).to.have.property(\"bookingdates\");\r",
              "});\r",
              "\r",
              "pm.test(\"Los datos actualizados coinciden con los enviados\", function () {\r",
              "    const datosEnviados = JSON.parse(\r",
              "        pm.variables.replaceIn(pm.request.body.raw)\r",
              "    );\r",
              "    pm.expect(respuesta).to.eql(datosEnviados);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta tiene formato JSON\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"El tiempo de respuesta es menor a 2000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
